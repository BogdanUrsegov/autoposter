# Telegram
BOT_TOKEN=123456:REPLACE_ME
ADMIN_IDS=6005734111

# Admin panel
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-this-to-a-long-random-string
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEBAPP_URL=

# PostgreSQL (used by docker-compose)
POSTGRES_DB=clickbot
POSTGRES_USER=clickbot
POSTGRES_PASSWORD=change-me

# The compose file overrides DATABASE_URL for the bot service.
DATABASE_URL=postgresql+asyncpg://clickbot:change-me@postgres:5432/clickbot

# Optional proxy
PROXY=
PROXY_SCHEME=socks5

# Provider keys — put real values here, never in source code
SUBGRAM_KEY=
TGRASS_KEY=
BOTOHUB_KEY=
